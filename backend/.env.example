# Copy this file to .env and fill in real values.
# This file is committed to git as documentation only — never commit a real .env!

# === Supabase ===
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here   # SECRET — backend only
SUPABASE_JWT_SECRET=your-jwt-secret-here               # SECRET — backend only

# === Resend (email) ===
RESEND_API_KEY=re_your_resend_api_key                  # SECRET — backend only
# Set to "log" to skip real sending during local development:
# RESEND_API_KEY=log
EMAIL_FROM=Narkadhai <noreply@yourdomain.com>
OWNER_EMAIL=owner@example.com

# === CORS ===
FRONTEND_URL=https://narkadhai.vercel.app              # Your deployed frontend URL

# === Environment ===
ENVIRONMENT=development
