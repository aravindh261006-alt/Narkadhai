# Copy this file to .env and fill in real values.
# This file is committed to git as documentation only — never commit a real .env!

# === Supabase ===
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here   # SECRET — backend only
SUPABASE_JWT_SECRET=your-jwt-secret-here               # SECRET — backend only

# === Gmail API (OAuth2 over HTTPS 443) ===
GMAIL_USER=support.narkadhai@gmail.com
GMAIL_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
# Set to "log" to skip real sending during local development:
GMAIL_REFRESH_TOKEN=log
EMAIL_FROM=Narkadhai <support.narkadhai@gmail.com>
EMAIL_REPLY_TO=support.narkadhai@gmail.com
OWNER_EMAIL=support.narkadhai@gmail.com

# === CORS ===
FRONTEND_URL=https://narkadhai.vercel.app              # Your deployed frontend URL

# === Environment ===
ENVIRONMENT=development
